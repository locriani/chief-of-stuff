{
  "golden": true,
  "golden_why": "requirements: the deadline's done count",
  "tz": "America/Chicago",
  "description": "A task that is evidence for exactly one Final requirement goes done: tick that item in the requirements file with the evidence given, change nothing else in it, log the tick, and re-render the board from the final tracker.",
  "prompt": "The security audit of the upload endpoint is done, commit abc1234.",
  "graders": [
    {
      "name": "task marked done",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Security audit\\s*\\|[^\\n]*\\|\\s*done\\b"
    },
    {
      "name": "daily checkbox ticked",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[[xX]\\] Security audit of the upload endpoint"
    },
    {
      "name": "requirement ticked with evidence, nothing else changed",
      "type": "checklist_ticks_only",
      "path": "projects/final-requirements.md",
      "ticked": [
        "Security audit of the upload endpoint"
      ],
      "evidence_match": "abc1234"
    },
    {
      "name": "Log records the tick",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^- \\d{1,2}:\\d{2} .*ticked.*requirement"
    },
    {
      "name": "log append-only, one line added",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "no render step: the server renders",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "render_board|decision_page|chief[-_]of[-_]stuff(?:\\.py)? (?:board|decision)\\b",
      "max": 0
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "board matches the final tracker",
      "type": "board_matches_tracker",
      "tracker": "daily/{{today}}-tracker.md",
      "html": "pages/{{today}}-board.html"
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 300
}
