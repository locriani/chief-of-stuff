{
  "golden": true,
  "golden_why": "sessions: the keying bug class, name vs ref",
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "A session renames itself between turns. The registry is keyed on the ref, so the next message still reaches it and the row keeps one entry under the new name.",
  "turns": [
    {
      "prompt": "Ask 4821-audit for a status.",
      "graders": [
        {
          "name": "polls by ref",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "a1b2c3",
          "ok": true,
          "min": 1
        }
      ]
    },
    {
      "prompt": "<cross-session-message from=\"uds:/tmp/cc-socks/4821.sock\" from-name=\"4821-audit-v2\" from-mode=\"prompting\">\nCurrent task: upload endpoint audit, writing findings; state: running. Waiting on: nothing. Free: in 30 minutes. Not blocked. No standing constraints.\n</cross-session-message>",
      "peers": "sessions-renamed.json",
      "graders": [
        {
          "name": "row carries the new name",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\|\\s*a1b2c3\\s*\\|\\s*4821-audit-v2\\s*\\|"
        },
        {
          "name": "one row for that ref",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\|\\s*a1b2c3\\s*\\|",
          "count": 1
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    },
    {
      "prompt": "Send 4821-audit this: keep going, and report when the findings are written.",
      "graders": [
        {
          "name": "relays the instruction in Robin's words",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "a1b2c3",
          "ok": true,
          "text_match": "(?i)findings",
          "min": 1
        },
        {
          "name": "lists sessions before sending",
          "type": "peer_calls",
          "tool": "list_sessions",
          "min": 1
        },
        {
          "name": "reaches the same session by ref",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "a1b2c3",
          "ok": true,
          "min": 1
        },
        {
          "name": "row still keyed on the ref",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\|\\s*a1b2c3\\s*\\|",
          "count": 1
        }
      ]
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 400
}
