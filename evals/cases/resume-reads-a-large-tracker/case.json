{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "A new session on a day whose tracker holds sixty tasks with paragraph-long items. Resume reads it through a `chief-of-stuff tracker` subcommand, never with grep, sed, awk, cat, head, tail or cut on the tracker file, and still reports what the `## Resume` block says (#46).",
  "prompt": "resume",
  "graders": [
    {
      "name": "tracker read through a tracker subcommand",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:chief[-_]of[-_]stuff(?:\\.py)?\\s+tracker|tracker_read\\.py)\\b(?:\\s+--\\w+(?:[= ]\\S+)?)*\\s+(?:header|sections|section|tasks)\\b",
      "min": 1
    },
    {
      "name": "no shell text tool on the tracker file",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "^(?=.*(?:tracker\\.md|\\*-tracker)).*(?:\"command\": \"|[;&|(`]|\\\\n|\\b(?:do|then|else|xargs)\\s)\\s*(?:\\w+=\\S*\\s+)*(?:[\\w./-]*/)?(?:grep|sed|awk|cat|head|tail|cut)\\b",
      "max": 0
    },
    {
      "name": "no Grep on the tracker file",
      "type": "tool_used",
      "tool": "Grep",
      "input_match": "tracker\\.md",
      "max": 0
    },
    {
      "name": "reply names what was in flight",
      "type": "regex",
      "pattern": "(?i)(audit poll|poll[^\\n]{0,30}(out|outstanding|pending)|4821-audit)"
    },
    {
      "name": "reply names what Robin owes",
      "type": "regex",
      "pattern": "(?i)release notes"
    }
  ],
  "max_turns": 25,
  "timeout_seconds": 600
}
