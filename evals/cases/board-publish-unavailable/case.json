{
  "tz": "America/Chicago",
  "description": "As board-republish-on-lane-change, but the publish tool is absent. Finish the move (lane done, checkbox, Log), render the html, say the board was not republished and why. Never hand-edit the html. Non-discriminating on baseline; kept as a guard.",
  "prompt": "The audit is done.",
  "graders": [
    {
      "name": "lane marked done",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Security audit\\s*\\|[^\\n]*\\|\\s*done\\b"
    },
    {
      "name": "checkbox ticked",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[[xX]\\] Security audit of the upload endpoint"
    },
    {
      "name": "other checkbox untouched",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[ \\] Draft release notes"
    },
    {
      "name": "other lane untouched",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Draft release notes \\| Robin \\| open \\| 09:00 \\|  \\| Checklist: Draft release notes \\|$"
    },
    {
      "name": "log append-only, one line added",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "says the board was not republished",
      "type": "regex",
      "pattern": "(?i)(board|page|version)[^\\n]*(not|n't|couldn't|could not|unable|isn't|no)[^\\n]*(publish|republish|online|updated)|(tool|publish\\w*)[^\\n]*(unavailable|not available|isn't available|is not available|missing|absent)"
    },
    {
      "name": "html re-rendered from the tracker",
      "type": "file_matches",
      "path": "daily/{{today}}-board.html",
      "pattern": "name=\"tracker-sha256\" content=\"[0-9a-f]{64}\""
    },
    {
      "name": "stale html replaced by the renderer",
      "type": "file_matches",
      "path": "daily/{{today}}-board.html",
      "pattern": "stale board from an earlier move",
      "match": "absent"
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 300,
  "board": false
}
