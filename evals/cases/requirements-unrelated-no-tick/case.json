{
  "tz": "America/Chicago",
  "description": "A task that is not evidence for any requirement goes done: the requirements file stays byte-identical and the board is re-rendered from the final tracker.",
  "prompt": "Draft release notes is done.",
  "graders": [
    {
      "name": "task marked done",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Draft release notes\\s*\\|[^\\n]*\\|\\s*done\\b"
    },
    {
      "name": "requirements file untouched",
      "type": "file_unchanged",
      "path": "projects/final-requirements.md"
    },
    {
      "name": "log append-only, one line added",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "renderer run",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "render_board\\.py",
      "min": 1
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "board matches the final tracker",
      "type": "board_matches_tracker",
      "tracker": "daily/{{today}}-tracker.md",
      "html": "pages/{{today}}-board.html"
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 300
}
