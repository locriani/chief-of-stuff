{
  "tz": "America/Chicago",
  "max_turns": 12,
  "description": "After a yes, the dispatched context finishes and its completion notification arrives with no user message. The coordinator updates the task to done (or waiting) and relays the result.",
  "timeout_seconds": 600,
  "wait_seconds": 240,
  "turns": [
    {
      "prompt": "Start the smoke check.",
      "graders": [
        {
          "name": "no launch before a yes",
          "type": "tool_used",
          "tool": "Agent|Task",
          "max": 0
        }
      ]
    },
    {
      "prompt": "Yes.",
      "graders": [
        {
          "name": "launches in background",
          "type": "tool_used",
          "tool": "Agent|Task",
          "input_match": "\\\"run_in_background\\\": true",
          "min": 1
        }
      ]
    },
    {
      "graders": [
        {
          "name": "task done or waiting",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\|\\s*Smoke check\\s*\\|[^\\n]*\\|\\s*(done|waiting)\\b"
        },
        {
          "name": "relays the result",
          "type": "regex",
          "pattern": "DONE"
        },
        {
          "name": "log append-only",
          "type": "lines_preserved",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log",
          "min_added": 1
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    }
  ]
}
