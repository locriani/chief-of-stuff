{
  "tz": "America/Chicago",
  "description": "open-the-day with a Board line and no URL yet: the move ends by running the renderer and publishing the board once, then writing the URL into the tracker header. Never hand-written html.",
  "prompt": "Good morning.",
  "graders": [
    {
      "name": "queries both calendars for today",
      "type": "mock_calls",
      "calendar_ids": [
        "cal-work",
        "cal-program"
      ],
      "covers": "{{today}}"
    },
    {
      "name": "log carries over README item",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Write eval README"
    },
    {
      "name": "log carries over deploy review",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Review deploy config"
    },
    {
      "name": "log lists standup",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Standup"
    },
    {
      "name": "log lists class",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Data modeling"
    },
    {
      "name": "goal empty or marked proposed",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "^## Goal[ \\t]*\\n\\s*(?:##|.*(?i:proposed|TBD))"
    },
    {
      "name": "tracker lane: README",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Write eval README\\s*\\|"
    },
    {
      "name": "tracker lane: deploy review",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Review deploy config\\s*\\|"
    },
    {
      "name": "tracker has Decisions",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## Decisions"
    },
    {
      "name": "tracker has File ownership",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## File ownership"
    },
    {
      "name": "tracker has Log",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## Log"
    },
    {
      "name": "no other new files",
      "type": "no_new_files",
      "except": [
        "daily/{{today}}.md",
        "daily/{{today}}-tracker.md",
        "daily/{{today}}-board.html"
      ]
    },
    {
      "name": "yesterday's log untouched",
      "type": "file_unchanged",
      "path": "daily/{{yesterday}}.md"
    },
    {
      "name": "yesterday's tracker untouched",
      "type": "file_unchanged",
      "path": "daily/{{yesterday}}-tracker.md"
    },
    {
      "name": "ends with a question",
      "type": "regex",
      "pattern": "\\?\\s*\\Z"
    },
    {
      "name": "reads the real clock",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bdate\\b",
      "min": 1
    },
    {
      "name": "clock line to the deadline",
      "type": "clock_line",
      "gate": "{{today}} 23:59"
    },
    {
      "name": "renderer run",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "render_board\\.py",
      "min": 1
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "board published with both carried lanes and the deadline",
      "type": "board_published",
      "min": 1,
      "lanes": [
        "Write eval README",
        "Review deploy config"
      ],
      "deadline": "{{today}}T23:59:00-05:00"
    },
    {
      "name": "board matches the final tracker",
      "type": "board_matches_tracker",
      "tracker": "daily/{{today}}-tracker.md",
      "html": "daily/{{today}}-board.html"
    },
    {
      "name": "url in the tracker header, one url",
      "type": "board_url_fixed",
      "tracker": "daily/{{today}}-tracker.md"
    }
  ],
  "max_turns": 24,
  "timeout_seconds": 300,
  "calendar": "calendar.json",
  "board": {
    "url": null
  }
}
