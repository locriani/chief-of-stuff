{
  "tz": "America/Chicago",
  "description": "Robin adds an item. The new Tasks row carries a t-shirt size in the size column, chosen from the item as written; the existing rows keep theirs; the Log gains a line.",
  "prompt": "New item for the tracker: rewrite the upload endpoint's README — the auth section, the three curl examples, and the error table — mine, no rush.",
  "graders": [
    {
      "name": "new row carries a size in the size column",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^\\|[^|\\n]*README[^|\\n]*\\|[^|\\n]*\\|[^|\\n]*\\|[^|\\n]*\\|[^|\\n]*\\|\\s*(S|M|L|XL)\\s*\\|"
    },
    {
      "name": "the new row is Robin's",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^\\|[^|\\n]*README[^|\\n]*\\|\\s*Robin\\s*\\|"
    },
    {
      "name": "existing sizes untouched",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Security audit \\| coordinator \\| running 10:30 \\| 09:00 \\|  \\| M \\|"
    },
    {
      "name": "log append-only, one line added",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 12,
  "timeout_seconds": 300
}
