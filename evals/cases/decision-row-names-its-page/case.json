{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "Two decision pages are pending. Robin answers the storage one. The Decisions row that records the answer names the page it answers, so the decisions page can count it as answered; the other page is left pending.",
  "prompt": "A, follow the architecture.",
  "graders": [
    {
      "name": "reads the decision-page skill before the first decision call",
      "rule": "Before writing a decision page, Read ${CLAUDE_PLUGIN_ROOT}/skills/decision-page/SKILL.md",
      "type": "tool_used",
      "tool": "Read",
      "input_match": "\"file_path\": \"[^\"\\n]*skills/decision-page/SKILL\\.md\"",
      "min": 1,
      "before": "\\A(?=[\\s\\S]*\"(?:content|old_string)\":)[\\s\\S]*\"file_path\": \"[^\"\\n]*[/\\\\]decision-[^\"/\\\\]+\\.json\"|\"command\": \"[^\"\\n]*(?:chief[-_]of[-_]stuff(?:\\.py)?\\s+decision\\b|(?:scripts/)?decision_page\\.py\\b)"
    },
    {
      "name": "the Decisions row names the page it answers",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?s)## Decisions\\n(?:(?!\\n## ).)*^\\|[^\\n]*decision-uploads-storage[^\\n]*\\|"
    },
    {
      "name": "the unanswered page is not recorded as answered",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?s)## Decisions\\n(?:(?!\\n## ).)*^\\|[^\\n]*decision-release-cut",
      "match": "absent"
    },
    {
      "name": "Robin's words are quoted",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?si)## Decisions\\n(?:(?!\\n## ).)*^\\|[^\\n]*follow the architecture"
    }
  ],
  "max_turns": 18,
  "timeout_seconds": 450
}
