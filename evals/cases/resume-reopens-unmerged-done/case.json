{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "repo": {
    "trees": "trees",
    "worktrees": [
      {
        "name": "wt-audit",
        "branch": "feat/audit",
        "merged": false
      }
    ],
    "files": {
      "src/a/upload.py": "def upload(request):\n    path = request.get('path')\n    return open(path, 'wb')\n",
      "src/a/__init__.py": "",
      "notes/.keep": ""
    }
  },
  "description": "A task marked done in a worktree whose branch never reached main. The audit reopens it; the task with no tree is untouched.",
  "prompt": "resume",
  "graders": [
    {
      "name": "audit script run",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\"command\": \"(?:[^\"\\\\]|\\\\.)*?(?:chief[-_]of[-_]stuff(?:\\.py)?\\s+audit\\b(?!\\s+--help)|(?<![\\w.-])audit_tasks\\.py)",
      "min": 1
    },
    {
      "name": "the unmerged task is reopened",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Security audit \\|[^\\n]*\\|\\s*waiting\\s*\\|"
    },
    {
      "name": "its checklist item is not ticked",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[ \\] Security audit of the upload endpoint"
    },
    {
      "name": "the task with no tree stays done",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Draft release notes \\| Robin \\| done"
    },
    {
      "name": "Log says why",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^- \\d{1,2}:\\d{2}[^\\n]*(not on main|unmerged|wt-audit|feat/audit)"
    },
    {
      "name": "reply says it once",
      "type": "regex",
      "pattern": "(?i)((?:not|n't) on main|unmerged|not (yet )?merged|nothing merged|still on [`']?feat|on a branch)"
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    },
    {
      "type": "board_matches_tracker",
      "name": "the board is re-rendered from the final tracker",
      "tracker": "daily/{{today}}-tracker.md"
    },
    {
      "name": "it runs the CLI without probing for its form (#233)",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\"command\": \"(?:[^\"\\\\]|\\\\.)*?(?:\\bprintenv\\b|\\benv\\s*\\||\\$\\{?CHIEF_OF_STUFF_RELEASE|(?:\\bwhich|\\btype|\\bwhereis|\\bcommand\\s+-v)\\s+chief-of-stuff|\\b(?:echo|printf|ls)\\b[^\"]*?\\$\\{?CLAUDE_PLUGIN_ROOT|chief[-_]of[-_]stuff(?:\\.py)?\\s+(?:--help|-h|--version)\\b)",
      "max": 0
    },
    {
      "name": "it never runs a chief-of-stuff found on PATH (#233)",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\"(?:command|CommandLine|cmd)\": \"(?:[^\"\\\\]|\\\\.)*?(?:(?<=\\\\n)|(?<![\\w./-]))chief-of-stuff(?=\\s|\\\\n|\\\\?\"|;|&|\\||\\)|`)",
      "max": 0
    }
  ],
  "max_turns": 20,
  "timeout_seconds": 420
}
