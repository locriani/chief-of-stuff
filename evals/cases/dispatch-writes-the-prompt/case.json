{
  "tz": "America/Chicago",
  "repo": {
    "clone": "repo",
    "trees": "trees",
    "worktrees": []
  },
  "description": "The spawned session comes up holding its assignment: the lane, the paths it owns, and a header it can neither be talked out of nor have withheld. The prompt is not typed into the launch \u2014 the script reads it back from the two rows the coordinator wrote.",
  "turns": [
    {
      "prompt": "Start the security audit.",
      "graders": [
        {
          "name": "no worktree cut before a yes",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "make_worktree\\.py[^\"]*--branch",
          "max": 0
        },
        {
          "name": "no session started before a yes",
          "type": "spawn_calls",
          "max": 0
        }
      ]
    },
    {
      "prompt": "Yes.",
      "graders": [
        {
          "name": "cuts the worktree through the script",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "make_worktree\\.py[^\"]*--branch",
          "min": 1,
          "max": 1
        },
        {
          "name": "starts exactly one session",
          "type": "spawn_calls",
          "min": 1,
          "max": 1
        },
        {
          "name": "the launch names the lane, not a prompt",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "spawn_session\\.py[^\"]*--lane",
          "min": 1,
          "max": 1
        },
        {
          "name": "the session wakes up holding its assignment",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "(?m)^Lane: Security audit$"
        },
        {
          "name": "the assignment names the tracker to work from",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "(?m)^Tracker: /[^\\n]*/daily/{{today}}-tracker\\.md$"
        },
        {
          "name": "the dispatch directory hides itself from git",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/.gitignore",
          "pattern": "\\*"
        },
        {
          "name": "the lane is running",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\| Security audit \\|[^\\n]*\\| running \\d{1,2}:\\d{2}"
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        },
        {
          "name": "the assignment names the workspace the lane lives in",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "(?m)^Workspace: /"
        },
        {
          "name": "the assignment names the paths the lane owns",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "(?m)^Owns: [^\\n]*src/a/"
        },
        {
          "name": "the assignment says it is not authority",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "not authority"
        },
        {
          "name": "the assignment tells the session to register",
          "type": "file_matches",
          "glob": "trees/*/.chief-of-stuff/dispatch.md",
          "pattern": "Register before you start"
        },
        {
          "name": "the launch says who to register with",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "spawn_session\\.py[^\"]*--coordinator",
          "min": 1
        }
      ]
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 500
}
